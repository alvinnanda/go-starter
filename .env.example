# Server Configuration
PORT=8086
# ALLOWED_ORIGINS=development

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=1sampai6
DB_NAME=starter_db

# Database Pool Configuration
DB_POOL_MAX_CONNS=10
DB_POOL_MIN_CONNS=2
DB_POOL_MAX_CONN_LIFETIME=1h
DB_POOL_MAX_CONN_IDLE_TIME=30m
